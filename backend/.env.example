HF_TOKEN=your_huggingface_token_here
WANDB_API_KEY=your_wandb_api_key_here
HF_XET_HIGH_PERFORMANCE=1

# Admin API key for protected endpoints (register/delete databases).
# Required to use the admin endpoints. Keep secret in production.
ADMIN_API_KEY=change-me-in-production

# Optional: directories from which admin database paths may be registered.
# Defaults to backend/data. Comma-separated.
# ALLOWED_DB_DIRS=/home/user/databases,/mnt/data

# Test database URLs for the docker test-db profile.
# TEST_POSTGRES_URL=postgresql://querra:querra@localhost:5433/querra_test
# TEST_MYSQL_URL=mysql://querra:querra@localhost:3307/querra_test

# Optional: comma-separated allowed CORS origins for the API.
# Default is "*" (all origins), which is fine for local development only.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
